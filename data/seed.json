  "guidance": [
    {
      "guidance_id": "G1",
      "kind": "MEDICATION_SAFETY",
      "audience": "PATIENT",
      "text": "服用辛伐他汀（如舒降之）期间，请避免大量饮用西柚（葡萄柚）汁或大量食用西柚果肉。西柚中的呋喃香豆素可抑制肠道代谢酶，使药物浓度升高、副作用风险增加。请勿自行停药或调整用药，如需调整请咨询医生或药师。",
      "evidence_ids": ["E1"],
      "population_ids": ["elderly", "hepatic", "high-intake"],
      "reviewed_by": "李审核",
      "approved_at": "2026-05-12T09:00:00+08:00",
      "valid_until": "2027-06-30"
    },
    {
      "guidance_id": "G2",
      "kind": "MEDICATION_SAFETY",
      "audience": "PATIENT",
      "text": "服用非洛地平（如波依定）期间，请避免饮用西柚汁或食用西柚。西柚汁可明显升高血压药物浓度，可能引起头晕、面部潮红或低血压。请勿自行停药，如有疑问请咨询医生或药师。",
      "evidence_ids": ["E2"],
      "population_ids": ["elderly", "high-intake"],
      "reviewed_by": "李审核",
      "approved_at": "2026-05-12T09:00:00+08:00",
      "valid_until": "2027-06-30"
    },
    {
      "guidance_id": "G3",
      "kind": "MEDICATION_SAFETY",
      "audience": "PATIENT",
      "text": "体外研究提示，柚子中的柚皮苷可能影响非索非那定（如阿特拉）的吸收，但人体证据有限、临床意义尚不确定。请勿自行停药；如长期大量食用柚子或其制品，请咨询医生或药师。",
      "evidence_ids": ["E3"],
      "population_ids": ["adults"],
